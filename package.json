{
  "name": "@2chevskii/kaiten-client",
  "version": "2.0.0",
  "description": "Fully typed TypeScript client for Kaiten integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2chevskii/kaiten-client.git"
  },
  "homepage": "https://2chevskii.github.io/kaiten-client/",
  "bugs": "https://github.com/2chevskii/kaiten-client/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scim": {
      "types": "./dist/scim.d.ts",
      "default": "./dist/scim.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./imports": {
      "types": "./dist/imports.d.ts",
      "default": "./dist/imports.js"
    },
    "./addons": {
      "types": "./dist/addons.d.ts",
      "default": "./dist/addons.js"
    },
    "./addon-oauth": {
      "types": "./dist/addon-oauth.d.ts",
      "default": "./dist/addon-oauth.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "build:watch": "tsc --watch",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docs/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "sample:kaiten-rest": "npm run build && tsc -p samples/kaiten-rest/tsconfig.json && node samples/kaiten-rest/dist/index.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node --no-strip-types --test verification/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm test && npm run docs:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
