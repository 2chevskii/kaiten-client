{
  "name": "@2chevskii/kaiten-client",
  "version": "1.0.0",
  "description": "Fully typed TypeScript client for Kaiten integrations",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scim": {
      "types": "./dist/scim.d.ts",
      "default": "./dist/scim.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./imports": {
      "types": "./dist/imports.d.ts",
      "default": "./dist/imports.js"
    },
    "./addons": {
      "types": "./dist/addons.d.ts",
      "default": "./dist/addons.js"
    },
    "./addon-oauth": {
      "types": "./dist/addon-oauth.d.ts",
      "default": "./dist/addon-oauth.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.types.json",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
