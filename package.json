{
  "name": "@2chevskii/kaiten-client",
  "version": "1.0.0",
  "description": "Fully typed TypeScript client for Kaiten integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2chevskii/kaiten-client.git"
  },
  "homepage": "https://2chevskii.github.io/kaiten-client/",
  "bugs": "https://github.com/2chevskii/kaiten-client/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "docs"
  ],
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scim": {
      "types": "./lib/scim.d.ts",
      "default": "./lib/scim.js"
    },
    "./webhooks": {
      "types": "./lib/webhooks.d.ts",
      "default": "./lib/webhooks.js"
    },
    "./metadata": {
      "types": "./lib/metadata.d.ts",
      "default": "./lib/metadata.js"
    },
    "./imports": {
      "types": "./lib/imports.d.ts",
      "default": "./lib/imports.js"
    },
    "./addons": {
      "types": "./lib/addons.d.ts",
      "default": "./lib/addons.js"
    },
    "./addon-oauth": {
      "types": "./lib/addon-oauth.d.ts",
      "default": "./lib/addon-oauth.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "docs:dev": "npm run dev --workspace docs",
    "docs:build": "npm run build --workspace docs",
    "docs:preview": "npm run preview --workspace docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
