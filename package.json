{
  "name": "@2chevskii/kaiten-client",
  "version": "1.0.0",
  "description": "Fully typed TypeScript client for Kaiten integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2chevskii/kaiten-client.git"
  },
  "homepage": "https://github.com/2chevskii/kaiten-client#readme",
  "bugs": "https://github.com/2chevskii/kaiten-client/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scim": {
      "types": "./dist/scim.d.ts",
      "default": "./dist/scim.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./imports": {
      "types": "./dist/imports.d.ts",
      "default": "./dist/imports.js"
    },
    "./addons": {
      "types": "./dist/addons.d.ts",
      "default": "./dist/addons.js"
    },
    "./addon-oauth": {
      "types": "./dist/addon-oauth.d.ts",
      "default": "./dist/addon-oauth.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docs/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "sample:kaiten-rest": "npm run build && tsc -p samples/kaiten-rest/tsconfig.json && node samples/kaiten-rest/dist/index.js",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check && vitepress build docs",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitepress": "1.6.4"
  }
}
